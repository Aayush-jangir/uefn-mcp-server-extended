using { /Fortnite.com/Devices }
using { /Verse.org/Simulation }

# P14 probe device — tests whether a Verse rebuild clobbers writes made to a
# Verse device's @editable values. This is the case that matters for TheScar's
# nine VerseDevice_C managers. Safe to delete; never copy into TheScar.
#
# REBUILD MARKER 2 - code changed, @editable defaults deliberately untouched.
p14_probe_device := class(creative_device):

    @editable
    ProbeInt : int = 7

    @editable
    ProbeFloat : float = 1.5

    @editable
    ProbeString : string = "untouched"

    @editable
    ProbeBool : logic = false

    OnBegin<override>()<suspends> : void =
        Print("p14 probe rebuild 2: Int={ProbeInt} Float={ProbeFloat}")
        Print("p14 probe rebuild 2: String={ProbeString}")
